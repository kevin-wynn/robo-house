        <span class="text-xs tracking-widest uppercase text-muted">Mode</span>
        <span class="text-xs tracking-widest uppercase">Lookin'</span>
      </div>
      <div
        class="flex justify-between items-center py-3 border-b border-ink/10"
      >
        <iframe
          src="https://widget.qobuz.com/album/b9m4jll21u8ra?zone=US-en&display=compact"
          class="w-full h-96"></iframe>
      </div>
    </div>
  </div>
</div>

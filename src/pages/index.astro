---
import About from "../components/About.astro";
import Nav from "../components/Nav.astro";
import Rides from "../components/Rides.astro";
import WorkItem from "../components/WorkItem.astro";
import Base from "../layouts/Base.astro";
---

<Base title="ROBO HOUSE" description="Kevin Wynn. Builder. Robo House.">
  <main class="min-h-screen bg-cream text-ink font-mono overflow-hidden">
    <Nav />

    <!-- HERO -->
    <section
      class="relative min-h-screen flex flex-col justify-end pb-16 px-6 md:px-12"
    >
      <!-- BIG TYPE -->
      <div class="relative z-10">
        <div class="overflow-hidden mb-2">
          <h1
            class="font-condensed font-black italic leading-none select-none"
            style="font-size: clamp(5rem, 22vw, 22rem); letter-spacing: -0.02em; color: transparent; -webkit-text-stroke: 2px var(--red);"
          >
            ROBO
          </h1>
        </div>
        <div class="overflow-hidden">
          <h1
            class="font-condensed font-black leading-none select-none"
            style="font-size: clamp(5rem, 22vw, 22rem); letter-spacing: -0.02em; color: var(--ink);"
          >
            HOUSE
          </h1>
        </div>
      </div>

      <!-- VERTICAL LABEL LEFT -->
      <div
        class="absolute left-6 top-1/2 -translate-y-1/2 writing-vertical text-xs tracking-widest text-muted uppercase hidden md:block"
      >
        Est. 2024 — TEXAS
      </div>

      <!-- BOTTOM META -->
      <div class="relative z-10 flex justify-between items-end mt-12">
        <div>
          <p class="text-xs tracking-widest text-muted uppercase mb-1">
            Kevin Wynn
          </p>
          <p class="text-xs tracking-widest text-muted uppercase">
            I Am The Stack
          </p>
        </div>
        <div class="text-right">
          <p class="text-xs tracking-widest text-muted uppercase">Scroll</p>
          <div class="w-px h-12 bg-muted ml-auto mt-2 opacity-40"></div>
        </div>
      </div>
    </section>

    <!-- WORK SECTION -->
    <section id="work" class="px-6 md:px-12 py-24 border-t border-ink/10">
      <div class="flex justify-between items-baseline mb-16">
        <h2
          class="font-condensed font-black text-5xl md:text-7xl italic tracking-tight"
        >
          THE WORK
        </h2>
        <span
          class="text-xs tracking-widest text-muted uppercase hidden md:block"
          >Selected Projects</span
        >
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-ink/10">
        <WorkItem
          link="https://loggy.dev"
          title="LOGGY"
          description="Observability for developers. Logs, metrics, traces, feature flags, alerting, etc..."
          number="01"
          variant="red"
        />

        <WorkItem
          link="https://ashfront.com"
          title="ASHFRONT"
          description="Print on demand clothing line"
          number="02"
          variant="black"
        />

        <WorkItem
          link="https://gracklemag.com"
          title="GRACKLE"
          description="Indie culture mag in Waco, TX. Food, music, art, and the weirdos who make it."
          number="03"
          variant="black"
        />

        <WorkItem
          link="https://badcatch.com"
          title="BADCATCH"
          description="Personal web agency, basically this but more professional"
          number="04"
          variant="red"
        />

        <WorkItem
          link="https://lisq.io"
          title="LISQ"
          description="Omg a list app!.. or should I say. Tacticool lists. Self hosted, cool af."
          number="05"
          variant="red"
        />

        <WorkItem
          link="https://cadiv.cc"
          title="CADIV"
          description="Self hosted cycling insights and training."
          number="06"
          variant="black"
        />

        <!-- WYNN PUBLISHERS -->
